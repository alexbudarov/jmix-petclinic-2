<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://visitMonitor.title"
      focusComponent="visitsDataGrid">
    <data>
        <collection id="visitsDc"
                    class="io.jmix.petclinic.entity.visit.Visit">
            <fetchPlan extends="_base">
                <property name="pet" fetchPlan="_base">
                    <property name="type" fetchPlan="_instance_name"/>
                    <property name="owner" fetchPlan="_instance_name"/>
                </property>
                <property name="assignedNurse" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="visitsDl" readOnly="true">
                <query>
                    <![CDATA[select e from petclinic_Visit e]]>
                </query>
            </loader>
        </collection>
        <collection id="visitInfoDc" class="io.jmix.petclinic.view.visit.VisitInfo">
            <loader id="visitInfoDl" readOnly="true"/>
        </collection>

    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
        <timer id="timer" delay="2000" autostart="true" repeating="true"/>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <simplePagination id="pagination" dataLoader="visitInfoDl" itemsPerPageDefaultValue="200"/>
        <dataGrid id="visitsDataGrid"
                  width="100%"
                  height="100%"
                  dataContainer="visitInfoDc">
            <actions>
            </actions>
            <columns resizable="true">
                <column property="visit.pet"/>
                <column property="visit.type"/>
                <column property="visit.visitStart"/>
                <column property="visit.visitEnd"/>
                <column property="visit.assignedNurse"/>
                <column property="visit.description"/>
                <column property="visit.treatmentStatus"/>
                <column property="visit.pet.type"/>
                <column property="visit.pet.owner"/>
                <column property="price" key="price" header="Price"/>
                <column property="lastUpdated"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
