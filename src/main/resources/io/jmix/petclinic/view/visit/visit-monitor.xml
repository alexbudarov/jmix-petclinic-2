<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://visitMonitor.title"
      focusComponent="visitsDataGrid">
    <data>
        <collection id="visitInfoDc" class="io.jmix.petclinic.view.visit.VisitInfo">
            <loader id="visitInfoDl" readOnly="true"/>
        </collection>

    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
        </urlQueryParameters>
        <timer id="timer" delay="30000" autostart="true" repeating="true"/>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <dataGrid id="visitsDataGrid"
                  width="100%"
                  height="100%"
                  dataContainer="visitInfoDc">
            <actions>
            </actions>
            <columns resizable="true">
                <column property="visit.pet"/>
                <column property="visit.type"/>
                <column property="visit.visitStart"/>
                <column property="visit.visitEnd"/>
                <column property="visit.assignedNurse"/>
                <column property="visit.description"/>
                <column property="visit.treatmentStatus"/>
                <column property="visit.pet.type"/>
                <column property="visit.pet.owner"/>
                <column property="price" key="price" header="Price" editable="true"/>
                <column property="lastUpdated"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
